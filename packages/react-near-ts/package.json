{
  "name": "react-near-ts",
  "version": "0.4.0",
  "description": "TypeScript-first toolkit for integrating NEAR Protocol with your React application",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.101.4 <6",
    "react": ">=19.2.8 <20",
    "react-dom": ">=19.2.8 <20",
    "zod": ">=4.4.3 <5"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "near-api-ts": "workspace:*",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "types": "./dist/index.d.mts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "types",
    "package.json",
    "LICENSE.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/near/near-api-ts.git",
    "directory": "packages/react-near-ts"
  },
  "keywords": [
    "near",
    "near-protocol",
    "near-api",
    "react",
    "react-query",
    "typescript",
    "web3",
    "blockchain"
  ],
  "author": {
    "name": "Volodymyr <eclipseeer> Bilyk",
    "email": "volodymyr@lantstool.dev"
  },
  "license": "MIT"
}
