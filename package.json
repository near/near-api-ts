{
  "name": "near-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint:fix": "biome check --write .",
    "check:placement": "node scripts/checkModulePlacement/checkModulePlacement.mjs",
    "sandbox:start": "tsx scripts/start-sandbox.ts",
    "sandbox:stop": "kill-port 4567"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^25.9.5",
    "kill-port": "^2.0.1",
    "near-sandbox": "0.3.1",
    "tsdown": "0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
